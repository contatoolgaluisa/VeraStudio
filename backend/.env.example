# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA coloque credenciais reais neste arquivo de exemplo.

NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# Origens que podem chamar a API (separadas por vírgula, sem barra no final)
CORS_ORIGINS=http://localhost:5173

# --- Banco de dados ---
# Local: Postgres do docker-compose (`npm run db:up` na raiz).
# Produção (Supabase):
#   DATABASE_URL -> URL do "Transaction pooler" (porta 6543), usada pela aplicação
#   DIRECT_URL   -> URL da conexão direta ou "Session pooler" (porta 5432), usada só pelas migrations
DATABASE_URL=postgresql://vera:vera_local_dev@localhost:5432/vera_studio
DIRECT_URL=postgresql://vera:vera_local_dev@localhost:5432/vera_studio

# Banco usado SOMENTE pelos testes automatizados (os testes apagam os dados dele).
# Criado automaticamente pelo docker-compose. Nunca aponte para o banco de produção.
TEST_DATABASE_URL=postgresql://vera:vera_local_dev@localhost:5432/vera_studio_test

# --- Supabase (Fase 5) ---
# Project URL do Supabase (Project Settings > Data API). Usada para conferir o
# login: o backend baixa as chaves PÚBLICAS de https://<projeto>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://seu-projeto.supabase.co

# --- Fases seguintes (ainda não utilizadas) ---
# SUPABASE_SECRET_KEY=   # Fase 5B (Storage). Só no backend, nunca no frontend.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
