// Schema do banco de dados da VÉRA Studio.
//
// Convenções:
// - Nomes em camelCase no código e snake_case no banco (@map / @@map),
//   o padrão do PostgreSQL e do Supabase.
// - Dinheiro em CENTAVOS (Int): R$ 129,90 = 12990. É o formato do Stripe
//   e evita erros de arredondamento de números decimais.
// - IDs UUID v7: únicos globalmente e ordenáveis por data de criação.
//
// Regras que o Prisma não expressa (CHECK constraints e Row Level Security)
// ficam no SQL da migration, em prisma/migrations.
//
// Fase 3: catálogo. Usuários, pedidos e pagamentos entram nas fases 5 a 7,
// cada um com a sua migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Ciclo de vida de um produto. Só PUBLISHED aparece na loja.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String        @unique
  description String
  categoryId  String        @map("category_id") @db.Uuid
  /// Preço de venda atual, em centavos.
  priceCents  Int           @map("price_cents")
  /// Preço "de" (riscado). Quando preenchido, o produto está em promoção.
  /// Precisa ser maior que priceCents (garantido por CHECK no banco).
  compareAtPriceCents Int?  @map("compare_at_price_cents")
  status      ProductStatus @default(DRAFT)
  /// Marcado pelo administrador para aparecer em "Novidades".
  isNew       Boolean       @default(false) @map("is_new")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Restrict: uma categoria com produtos não pode ser apagada por engano.
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  variants ProductVariant[]

  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([status, priceCents])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  /// URL pública da imagem.
  url         String
  /// Caminho no Supabase Storage, quando a imagem foi enviada pelo painel.
  /// Necessário para apagar o arquivo junto com o registro.
  storagePath String?  @map("storage_path")
  /// Texto alternativo (acessibilidade).
  alt         String
  /// Cor da variação que a foto mostra (opcional).
  color       String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// Uma combinação vendável de cor + tamanho, com SKU e estoque próprios.
model ProductVariant {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  sku       String   @unique
  color     String
  /// Cor em hexadecimal (#RRGGBB), para desenhar a amostra na loja.
  colorHex  String   @map("color_hex")
  size      String
  /// Unidades disponíveis para venda. Nunca negativo (CHECK no banco).
  stock     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Impede duas variações iguais (ex.: dois "Preto / M") no mesmo produto.
  @@unique([productId, color, size])
  @@index([color])
  @@index([size])
  @@map("product_variants")
}
