// Schema do banco de dados da VÉRA Studio.
//
// Convenções:
// - Nomes em camelCase no código e snake_case no banco (@map / @@map),
//   o padrão do PostgreSQL e do Supabase.
// - Dinheiro em CENTAVOS (Int): R$ 129,90 = 12990. É o formato do Stripe
//   e evita erros de arredondamento de números decimais.
// - IDs UUID v7: únicos globalmente e ordenáveis por data de criação.
//
// Regras que o Prisma não expressa (CHECK constraints e Row Level Security)
// ficam no SQL da migration, em prisma/migrations.
//
// Fase 3: catálogo. Fase 5: perfis de usuário. Fase 6: pedidos.
// Pagamentos entram na Fase 7, com a sua migration.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Ciclo de vida de um produto. Só PUBLISHED aparece na loja.
enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String    @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid(7)) @db.Uuid
  name        String
  slug        String        @unique
  description String
  categoryId  String        @map("category_id") @db.Uuid
  /// Preço de venda atual, em centavos.
  priceCents  Int           @map("price_cents")
  /// Preço "de" (riscado). Quando preenchido, o produto está em promoção.
  /// Precisa ser maior que priceCents (garantido por CHECK no banco).
  compareAtPriceCents Int?  @map("compare_at_price_cents")
  status      ProductStatus @default(DRAFT)
  /// Marcado pelo administrador para aparecer em "Novidades".
  isNew       Boolean       @default(false) @map("is_new")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Restrict: uma categoria com produtos não pode ser apagada por engano.
  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images   ProductImage[]
  variants ProductVariant[]

  @@index([status, categoryId])
  @@index([status, createdAt])
  @@index([status, priceCents])
  @@map("products")
}

model ProductImage {
  id          String   @id @default(uuid(7)) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  /// URL pública da imagem.
  url         String
  /// Caminho no Supabase Storage, quando a imagem foi enviada pelo painel.
  /// Necessário para apagar o arquivo junto com o registro.
  storagePath String?  @map("storage_path")
  /// Texto alternativo (acessibilidade).
  alt         String
  /// Cor da variação que a foto mostra (opcional).
  color       String?
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_images")
}

/// Uma combinação vendável de cor + tamanho, com SKU e estoque próprios.
model ProductVariant {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  sku       String   @unique
  color     String
  /// Cor em hexadecimal (#RRGGBB), para desenhar a amostra na loja.
  colorHex  String   @map("color_hex")
  size      String
  /// Unidades disponíveis para venda. Nunca negativo (CHECK no banco).
  stock     Int      @default(0)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  // Impede duas variações iguais (ex.: dois "Preto / M") no mesmo produto.
  @@unique([productId, color, size])
  @@index([color])
  @@index([size])
  @@map("product_variants")
}

/// Papel do usuário na loja. O cadastro público sempre cria CUSTOMER;
/// ADMIN só é concedido pelo script `npm run make-admin` (no servidor).
enum Role {
  CUSTOMER
  ADMIN
}

/// Dados da loja sobre cada usuário. A identidade (e-mail, senha, sessão)
/// fica no Supabase Auth; o `id` aqui é o mesmo id do usuário de lá.
/// O papel fica AQUI, e não no token, para que o próprio usuário não
/// consiga alterá-lo.
model UserProfile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders         Order[]
  statusChanges  OrderStatusHistory[]

  @@map("user_profiles")
}

/// Situação do pedido. As mudanças permitidas ficam em orders/order-status.ts:
///
///   PENDING_PAYMENT ──(pagamento confirmado pelo Stripe, Fase 7)──> PAID
///   PENDING_PAYMENT ──(30 min sem pagamento)──> EXPIRED
///   PENDING_PAYMENT ──(cliente ou administrador desiste)──> CANCELLED
///   PAID ──> PROCESSING ──> SHIPPED ──> DELIVERED   (administrador)
///
/// Ninguém marca PAID pelo painel: só a confirmação do pagamento.
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

model Order {
  id     String      @id @default(uuid(7)) @db.Uuid
  /// Número curto para o cliente e o atendimento (#1001, #1002...).
  number Int         @unique @default(autoincrement())
  userId String      @map("user_id") @db.Uuid
  status OrderStatus @default(PENDING_PAYMENT)
  /// E-mail no momento da compra (o perfil pode mudar depois).
  customerEmail  String @map("customer_email")
  /// Chave enviada pelo navegador para que um clique duplo não crie dois pedidos.
  idempotencyKey String @map("idempotency_key") @db.Uuid

  /// Valores calculados no servidor, em centavos, congelados na criação.
  itemCount     Int @map("item_count")
  subtotalCents Int @map("subtotal_cents")
  discountCents Int @map("discount_cents")
  shippingCents Int @map("shipping_cents")
  totalCents    Int @map("total_cents")

  /// Até quando o estoque fica reservado esperando o pagamento.
  reservationExpiresAt DateTime @map("reservation_expires_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Restrict: um cliente com pedidos não pode ser apagado (histórico de vendas).
  user          UserProfile          @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, reservationExpiresAt])
  @@map("orders")
}

/// Cópia do item no momento da compra. Se o produto mudar de nome ou preço
/// depois, o pedido continua mostrando o que foi comprado.
model OrderItem {
  id                  String  @id @default(uuid(7)) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  /// Referência à variação, para devolver o estoque. Os dados abaixo são cópias.
  variantId           String  @map("variant_id") @db.Uuid
  productName         String  @map("product_name")
  productSlug         String  @map("product_slug")
  sku                 String
  color               String
  size                String
  imageUrl            String? @map("image_url")
  unitPriceCents      Int     @map("unit_price_cents")
  compareAtPriceCents Int?    @map("compare_at_price_cents")
  quantity            Int
  lineTotalCents      Int     @map("line_total_cents")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict: uma variação vendida não pode ser apagada (só desativada).
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

/// Registro de cada mudança de situação: quem, quando, de onde para onde.
model OrderStatusHistory {
  id          String       @id @default(uuid(7)) @db.Uuid
  orderId     String       @map("order_id") @db.Uuid
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  /// Quem fez a mudança. Nulo quando foi o próprio sistema (ex.: reserva expirada).
  changedById String?      @map("changed_by_id") @db.Uuid
  note        String?
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy UserProfile? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}
