# Copie para `.env` e ajuste.
# ATENÇÃO: toda variável VITE_* vai parar no JavaScript enviado ao navegador,
# ou seja, é PÚBLICA. Nunca coloque chaves secretas aqui.

# Endereço da API (backend)
VITE_API_URL=http://localhost:3333

# Supabase Auth (Project Settings > API Keys)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
# Use a "Publishable key" (sb_publishable_...). NUNCA a secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_coloque_a_sua_aqui
