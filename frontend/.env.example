# Copie para `.env` e ajuste.
# ATENÇÃO: toda variável VITE_* vai parar no JavaScript enviado ao navegador,
# ou seja, é PÚBLICA. Nunca coloque chaves secretas aqui.

# Endereço da API (backend)
VITE_API_URL=http://localhost:3333

# --- Fase 5 (autenticação) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=   # chave pública ("anon"/"publishable"), nunca a service_role
